# Portainer connection
PORTAINER_URL=https://portainer.example.com:9443
API_KEY=ptr_replace_with_portainer_api_key
ALLOW_INSECURE_PORTAINER_HTTP=false

# Woods Keeper dashboard authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password
SECRET_KEY=replace_with_a_long_random_session_secret

# GitHub Actions image-build webhook
GITHUB_WEBHOOK_SECRET=replace_with_a_random_webhook_secret

# Optional application settings
PORT=5000
